---
import ProfileHeader from '~/components/home/ProfileHeader.astro'
import FeedTabs from '~/components/home/FeedTabs.astro'
import FeedCard from '~/components/home/FeedCard.astro'
import { FEED_CONFIG, SITE } from '~/config'
import Layout from '~/layouts/Layout.astro'
import { getVisibleFeed } from '~/lib/data'

const feed = FEED_CONFIG.ENABLED ? await getVisibleFeed() : []
const initialTab = FEED_CONFIG.TABS[0]?.key ?? 'featured'
---

<Layout title="Readme" description={SITE.description}>
  <div class="mx-auto w-full max-w-2xl space-y-12 px-6 pb-10 sm:px-8 sm:pb-14">
    <ProfileHeader />

    {
      feed.length > 0 && (
        <section class="space-y-4">
          <div class="flex min-w-0 justify-center">
            <FeedTabs tabs={FEED_CONFIG.TABS} />
          </div>

          <div class="flex flex-col gap-4" data-feed-list data-feed-active={initialTab}>
            {feed.map((item) => (
              <FeedCard item={item} activeTab={initialTab} />
            ))}
          </div>

          <p class="hidden py-10 text-center text-sm text-muted-foreground" data-feed-empty>
            {FEED_CONFIG.EMPTY_TEXT}
          </p>
        </section>
      )
    }
  </div>
</Layout>
