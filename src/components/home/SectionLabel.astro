---
import { cn } from '~/lib/utils'

interface Props {
  icon: string
  class?: string
}

const { icon, class: className }: Props = Astro.props
---

<div class={cn('flex items-center gap-2', className)}>
  <span class={cn('size-4 shrink-0 text-foreground', icon)}></span>
  <h2 class="text-[0.9375rem] font-semibold tracking-tight">
    <slot />
  </h2>
</div>
