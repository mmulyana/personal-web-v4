---
import ThemeToggle from '~/components/theme/ThemeToggle'
---

<header class="sticky top-0 z-10 bg-gradient-to-b from-background via-background/80 to-background/0">
  <div class="mx-auto flex max-w-2xl items-center justify-between px-6 sm:px-8 py-4 lg:px-8">
    <div class="flex min-w-0 items-baseline gap-1.5 opacity-0 -translate-y-1 transition-all duration-300" data-header-identity>
      <p class="truncate text-sm font-semibold tracking-tight">Mulyana</p>
      <p class="hidden shrink-0 text-sm text-muted-foreground sm:block">· Frontend Developer</p>
    </div>
    <div class="flex gap-2 items-center shrink-0" transition:persist="header-theme-toggle">
      <a
        href="/atom.xml"
        target="_blank"
        class="inline-flex items-center hover:scale-105 size-5 origin-center"
        aria-label="RSS Feed"
        title="RSS Feed"
      >
        <span class="icon-[material-symbols--rss-feed] size-5"></span>
      </a>
      <ThemeToggle client:load />
    </div>
  </div>
</header>

<script>
  const setupHeaderIdentity = () => {
    const identity = document.querySelector<HTMLElement>('[data-header-identity]')
    if (!identity) return

    const target = document.getElementById('profile-identity')
    if (!target) {
      identity.classList.remove('opacity-0', '-translate-y-1')
      return
    }

    const observer = new IntersectionObserver(
      ([entry]) => {
        identity.classList.toggle('opacity-0', entry.isIntersecting)
        identity.classList.toggle('-translate-y-1', entry.isIntersecting)
      },
      { rootMargin: '-72px 0px 0px 0px' }
    )
    observer.observe(target)
  }

  setupHeaderIdentity()
  document.addEventListener('astro:page-load', setupHeaderIdentity)
</script>
