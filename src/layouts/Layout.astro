---
import '~/styles/global.css'
import '~/styles/markdown.css'
import '~/styles/lqip.css'
import '~/styles/github-card.css'
import { SITE } from '~/config'
import Head from '~/components/base/Head.astro'
import ThemeToggle from '~/components/theme/ThemeToggle'

type Props = {
  title: string
  description: string
  image?: string
}

const { title, description, image }: Props = Astro.props
---

<!doctype html>
<html lang={SITE.lang} transition:name="root" transition:animate={SITE.transition ? 'fade' : 'none'}>
  <head>
    <Head title={title === SITE.title ? SITE.title : `${title} | ${SITE.title}`} {description} {image} />
  </head>
  <body class="flex flex-col">
    <div class="fixed top-4 right-4 z-10 sm:right-6" transition:persist="header-theme-toggle">
      <ThemeToggle client:load />
    </div>
    <div class="grow flex">
      <main class="relative mx-auto w-full grow min-w-0">
        <slot />
      </main>
    </div>
  </body>
</html>
